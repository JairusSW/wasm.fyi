[Unit]
Description=Discard finished wasm.fyi campaign SDKs and logs
After=wasmfyi-publisher.service

[Service]
Type=simple
EnvironmentFile=/etc/wasmfyi/history-cleanup.env
ExecStart=/usr/bin/python3 ${WASMFYI_CAMPAIGN_ROOT}/site/scripts/cleanup-finished-history.py ${WASMFYI_CAMPAIGN_ROOT} --ledger ${WASMFYI_PUBLICATION_LEDGER} --apply --watch
Restart=on-failure
RestartSec=10
# Keep only sdk-cleanup-status.json, not another growing cleanup log.
StandardOutput=null
StandardError=journal
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
