   (func (export "benchmark") (param $n i32) (result i32)
    (local $i i32) (local $sum i32)
    (loop $loop
     (local.set $sum (i32.add (local.get $sum)
      (i32.add (call 0 (local.get $i)) (call 1023 (i32.add (local.get $i) (i32.const 3))))))
