(module (type $f (func (param i32) (result i32))) (type $c (cont $f))
  (func $identity (type $f) (local.get 0)) (elem declare func $identity)(tag $yield (type $f))
  (func $yielding (type $f) (i32.add (suspend $yield (local.get 0)) (i32.const 11)))
  (elem declare func $yielding)
 (func (export "benchmark") (param $n i32) (result i32)
  (local $i i32) (local $sum i32) (local $saved (ref null $c)) (local $payload i32) 
  (block $done (br_if $done (i32.eqz (local.get $n)))
   (loop $again
    (local.set $sum (i32.add (local.get $sum) (block (result i32)
  (block $suspended (result i32 (ref $c))
   (drop (resume $c (on $yield $suspended) (local.get $i) (cont.new $c (ref.func $yielding)))) unreachable)
  (local.set $saved) (local.set $payload)
  (resume $c (i32.add (local.get $payload) (i32.const 5)) (local.get $saved)))))
    (local.set $i (i32.add (local.get $i) (i32.const 1)))
    (br_if $again (i32.lt_u (local.get $i) (local.get $n))))) (local.get $sum)))
