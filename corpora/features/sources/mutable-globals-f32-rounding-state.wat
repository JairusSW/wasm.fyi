(module (global $single (export "single") (mut f32) (f32.const 0))
  (func (export "benchmark") (param $n i32) (result i32)
    (local $i i32) (local $a i32) 
    (global.set $single (f32.const 16777216))
    (loop $loop
      (local.set $a (i32.add (local.get $a) (block (result i32)
      (global.set $single (f32.add (global.get $single)
        (f32.convert_i32_u (i32.add (i32.const 1) (i32.shl (i32.and (local.get $i) (i32.const 1)) (i32.const 1))))))
      (i32.reinterpret_f32 (global.get $single)))))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $loop (i32.lt_u (local.get $i) (local.get $n))))
    (local.get $a)))
