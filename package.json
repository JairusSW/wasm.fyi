{
  "name": "wasm.fyi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/frontend-assets.mjs && vite dev",
    "build": "node scripts/frontend-assets.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
