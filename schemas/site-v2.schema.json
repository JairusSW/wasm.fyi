{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm.fyi/schemas/site-v2.schema.json",
  "title": "Experimental site-v2 wire contract",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ObjectDescriptor": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "kind": {
          "enum": [
            "record",
            "evidence",
            "binary"
          ]
        }
      },
      "required": [
        "sha256",
        "bytes",
        "kind"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "binary"
            },
            "bytes": {
              "minimum": 0,
              "maximum": 16777216
            }
          }
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "record",
                "evidence"
              ]
            },
            "bytes": {
              "minimum": 1,
              "maximum": 262144
            }
          }
        }
      ]
    },
    "ExportManifest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 2
        },
        "format": {
          "const": "site-v2"
        },
        "reportId": {
          "$ref": "#/$defs/Digest"
        },
        "sourceReportSha256": {
          "$ref": "#/$defs/Digest"
        },
        "sourceSealSha256": {
          "$ref": "#/$defs/Digest"
        },
        "exporter": {
          "type": "string"
        },
        "verification": {
          "const": "source-recomputed"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectDescriptor"
          },
          "minItems": 0,
          "maxItems": 512
        },
        "inventoryPages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InventoryDescriptor"
          },
          "minItems": 1,
          "maxItems": 512
        },
        "exporterIdentity": {
          "$ref": "#/$defs/ExporterIdentity"
        }
      },
      "required": [
        "schema",
        "format",
        "reportId",
        "sourceReportSha256",
        "sourceSealSha256",
        "exporter",
        "verification",
        "objects"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "objects": {
              "minItems": 1
            }
          },
          "not": {
            "required": [
              "inventoryPages"
            ]
          }
        },
        {
          "properties": {
            "objects": {
              "maxItems": 0
            }
          },
          "required": [
            "inventoryPages"
          ]
        }
      ]
    },
    "ExportReference": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "manifest": {
          "$ref": "#/$defs/ExportManifest"
        }
      },
      "required": [
        "sha256",
        "manifest"
      ],
      "additionalProperties": false
    },
    "CompletedJob": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 2
        },
        "session": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "corpus": {
          "type": "string"
        },
        "attempt": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/Digest"
        },
        "configuredHarnessPin": {
          "type": "string"
        },
        "parentBundleSha256": {
          "$ref": "#/$defs/Digest"
        },
        "status": {
          "const": "completed"
        },
        "exports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportReference"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "schema",
        "session",
        "machine",
        "corpus",
        "attempt",
        "plan",
        "configuredHarnessPin",
        "parentBundleSha256",
        "status",
        "exports"
      ],
      "additionalProperties": false
    },
    "ProducerSummary": {
      "type": "object",
      "additionalProperties": true,
      "description": "Unchanged producer fields; exact integers outside JS safe range are decimal strings for size_bytes. No inferred intervals."
    },
    "ResultData": {
      "type": "object",
      "properties": {
        "reportId": {
          "$ref": "#/$defs/Digest"
        },
        "environmentId": {
          "$ref": "#/$defs/Digest"
        },
        "configurationId": {
          "$ref": "#/$defs/Digest"
        },
        "runtime": {
          "type": "string"
        },
        "contractId": {
          "$ref": "#/$defs/Digest"
        },
        "workload": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "statistic": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "analysisVersion": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/ProducerSummary"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Digest"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "trackId": {
          "$ref": "#/$defs/Digest"
        },
        "metricDefinitionId": {
          "$ref": "#/$defs/Digest"
        },
        "metricDefinitionStatus": {
          "enum": [
            "available",
            "unregistered"
          ]
        },
        "measurementMethod": {
          "$ref": "#/$defs/MeasurementMethod"
        },
        "measurementMethodId": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "reportId",
        "environmentId",
        "configurationId",
        "runtime",
        "contractId",
        "workload",
        "scenario",
        "profile",
        "metric",
        "statistic",
        "created",
        "analysisVersion",
        "summary",
        "evidence",
        "trackId",
        "metricDefinitionId",
        "metricDefinitionStatus"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "measurementMethod": [
          "measurementMethodId"
        ],
        "measurementMethodId": [
          "measurementMethod"
        ]
      }
    },
    "WireRecord": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "result",
            "report",
            "environment",
            "configuration",
            "workload",
            "metric",
            "artifact",
            "track"
          ]
        },
        "id": {
          "$ref": "#/$defs/Digest"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "kind",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    "RecordPage": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireRecord"
          }
        },
        "nextCursor": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "revision",
        "items",
        "nextCursor",
        "complete",
        "total"
      ],
      "additionalProperties": false
    },
    "DatasetManifest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 2
        },
        "revision": {
          "type": "string"
        },
        "selectionAliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "revision",
        "selectionAliases",
        "limits",
        "endpoints"
      ],
      "additionalProperties": false
    },
    "ExactInteger": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    },
    "InventoryDescriptor": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "objects": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "contentBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8589934592
        }
      },
      "required": [
        "sha256",
        "bytes",
        "objects",
        "contentBytes"
      ],
      "additionalProperties": false
    },
    "InventoryPage": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectDescriptor"
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "required": [
        "schema",
        "objects"
      ],
      "additionalProperties": false
    },
    "JSONResource": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "json-resource"
        },
        "schema": {
          "const": 1
        },
        "encoding": {
          "const": "json-utf8"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Digest"
          },
          "minItems": 1,
          "maxItems": 1024
        }
      },
      "required": [
        "kind",
        "schema",
        "encoding",
        "bytes",
        "sha256",
        "references"
      ],
      "additionalProperties": false
    },
    "JSONFragment": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "json-fragment"
        },
        "schema": {
          "const": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "schema",
        "text"
      ],
      "additionalProperties": false
    },
    "ExporterIdentity": {
      "type": "object",
      "properties": {
        "format": {
          "const": "site-v2"
        },
        "binarySha256": {
          "$ref": "#/$defs/Digest"
        },
        "goVersion": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "moduleVersion": {
          "type": "string"
        },
        "build": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "format",
        "binarySha256"
      ],
      "additionalProperties": false
    },
    "ObservationIdentity": {
      "type": "object",
      "properties": {
        "definitionVersion": {
          "type": "integer",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "maxLength": 4096
        },
        "scope": {
          "type": "string",
          "maxLength": 4096
        },
        "phase": {
          "type": "string",
          "maxLength": 4096
        },
        "collector": {
          "type": "string",
          "maxLength": 4096
        },
        "collectorVersion": {
          "type": "string",
          "maxLength": 4096
        },
        "quality": {
          "type": "string",
          "maxLength": 4096
        },
        "profile": {
          "type": "string",
          "maxLength": 4096
        },
        "denominator": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "definitionVersion",
        "unit",
        "scope",
        "phase",
        "collector",
        "collectorVersion",
        "quality",
        "profile",
        "denominator"
      ],
      "additionalProperties": false
    },
    "MeasurementMethod": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "status": {
          "enum": [
            "available",
            "unavailable"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        },
        "metric": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "statistic": {
          "type": "string"
        },
        "recipe": {
          "type": "object",
          "additionalProperties": true
        },
        "recipeSha256": {
          "$ref": "#/$defs/Digest"
        },
        "collectorStatus": {
          "enum": [
            "recorded",
            "not_recorded"
          ]
        },
        "observations": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/ObservationIdentity"
          }
        }
      },
      "required": [
        "schema",
        "status",
        "metric",
        "scenario",
        "profile",
        "statistic",
        "collectorStatus",
        "observations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "required": [
              "recipe",
              "recipeSha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "recipe"
                  ]
                },
                {
                  "required": [
                    "recipeSha256"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/CompletedJob"
}
