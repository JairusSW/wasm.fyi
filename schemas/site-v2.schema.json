{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm.fyi/schemas/site-v2.schema.json",
  "title": "Experimental site-v2 wire contract",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ObjectDescriptor": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "kind": {
          "enum": [
            "record",
            "evidence"
          ]
        }
      },
      "required": [
        "sha256",
        "bytes",
        "kind"
      ],
      "additionalProperties": false
    },
    "ExportManifest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 2
        },
        "format": {
          "const": "site-v2"
        },
        "reportId": {
          "$ref": "#/$defs/Digest"
        },
        "sourceReportSha256": {
          "$ref": "#/$defs/Digest"
        },
        "sourceSealSha256": {
          "$ref": "#/$defs/Digest"
        },
        "exporter": {
          "type": "string"
        },
        "verification": {
          "const": "source-recomputed"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectDescriptor"
          },
          "minItems": 1,
          "maxItems": 512
        }
      },
      "required": [
        "schema",
        "format",
        "reportId",
        "sourceReportSha256",
        "sourceSealSha256",
        "exporter",
        "verification",
        "objects"
      ],
      "additionalProperties": false
    },
    "ExportReference": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/Digest"
        },
        "manifest": {
          "$ref": "#/$defs/ExportManifest"
        }
      },
      "required": [
        "sha256",
        "manifest"
      ],
      "additionalProperties": false
    },
    "CompletedJob": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 2
        },
        "session": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "corpus": {
          "type": "string"
        },
        "attempt": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/Digest"
        },
        "configuredHarnessPin": {
          "type": "string"
        },
        "parentBundleSha256": {
          "$ref": "#/$defs/Digest"
        },
        "status": {
          "const": "completed"
        },
        "exports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportReference"
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": [
        "schema",
        "session",
        "machine",
        "corpus",
        "attempt",
        "plan",
        "configuredHarnessPin",
        "parentBundleSha256",
        "status",
        "exports"
      ],
      "additionalProperties": false
    },
    "ProducerSummary": {
      "type": "object",
      "additionalProperties": true,
      "description": "Unchanged producer fields; exact integers outside JS safe range are decimal strings for size_bytes. No inferred intervals."
    },
    "ResultData": {
      "type": "object",
      "properties": {
        "reportId": {
          "$ref": "#/$defs/Digest"
        },
        "environmentId": {
          "$ref": "#/$defs/Digest"
        },
        "configurationId": {
          "$ref": "#/$defs/Digest"
        },
        "runtime": {
          "type": "string"
        },
        "contractId": {
          "$ref": "#/$defs/Digest"
        },
        "workload": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "statistic": {
          "type": "string"
        },
        "created": {
          "type": "string",
          "format": "date-time"
        },
        "analysisVersion": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/ProducerSummary"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Digest"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "trackId": {
          "$ref": "#/$defs/Digest"
        },
        "metricDefinitionId": {
          "$ref": "#/$defs/Digest"
        },
        "metricDefinitionStatus": {
          "enum": [
            "available",
            "unregistered"
          ]
        }
      },
      "required": [
        "reportId",
        "environmentId",
        "configurationId",
        "runtime",
        "contractId",
        "workload",
        "scenario",
        "profile",
        "metric",
        "statistic",
        "created",
        "analysisVersion",
        "summary",
        "evidence",
        "trackId",
        "metricDefinitionId",
        "metricDefinitionStatus"
      ],
      "additionalProperties": false
    },
    "WireRecord": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "result",
            "report",
            "environment",
            "configuration",
            "workload",
            "metric",
            "artifact",
            "track"
          ]
        },
        "id": {
          "$ref": "#/$defs/Digest"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "kind",
        "id",
        "data"
      ],
      "additionalProperties": false
    },
    "RecordPage": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/WireRecord"
          }
        },
        "nextCursor": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "revision",
        "items",
        "nextCursor",
        "complete",
        "total"
      ],
      "additionalProperties": false
    },
    "DatasetManifest": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 2
        },
        "revision": {
          "type": "string"
        },
        "selectionAliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "endpoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "schema",
        "revision",
        "selectionAliases",
        "limits",
        "endpoints"
      ],
      "additionalProperties": false
    },
    "ExactInteger": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    }
  },
  "$ref": "#/$defs/CompletedJob"
}
