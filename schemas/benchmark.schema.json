{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wasm.fyi/schemas/benchmark.schema.json",
  "title": "Compact benchmark database wire contract",
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Result": {
      "type": "object",
      "properties": {
        "workload": {
          "type": "string"
        },
        "wasm": {
          "type": "string"
        },
        "artifactSha256": {
          "$ref": "#/$defs/Digest"
        },
        "contractSha256": {
          "$ref": "#/$defs/Digest"
        },
        "engine": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "compile",
            "instantiate",
            "first-call",
            "steady"
          ]
        },
        "latencyNs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peakRssBytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "codeBytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "memoryStatus": {
          "enum": [
            "ok",
            "failed",
            "unsupported",
            "disabled",
            "not-measured"
          ]
        },
        "codeStatus": {
          "enum": [
            "ok",
            "failed",
            "unsupported",
            "disabled",
            "not-measured"
          ]
        },
        "latencyStatus": {
          "enum": [
            "ok",
            "failed",
            "unsupported",
            "disabled",
            "not-measured"
          ]
        },
        "codeKind": {
          "enum": [
            "native-image",
            "engine-reported",
            "unknown",
            null
          ]
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "display": {
          "$ref": "#/$defs/Display"
        },
        "timingSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "samplesNs": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "workload",
        "wasm",
        "artifactSha256",
        "contractSha256",
        "engine",
        "version",
        "backend",
        "phase",
        "latencyStatus",
        "latencyNs",
        "memoryStatus",
        "codeStatus",
        "peakRssBytes",
        "codeBytes",
        "codeKind",
        "capturedAt"
      ],
      "additionalProperties": false
    },
    "Platform": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "kernel": {
          "type": "string"
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "os",
        "arch",
        "cpu",
        "cores",
        "kernel"
      ],
      "additionalProperties": false
    },
    "PlatformChoice": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "kernel": {
          "type": "string"
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 0
        },
        "id": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "os",
        "arch",
        "cpu",
        "cores",
        "kernel"
      ],
      "additionalProperties": false
    },
    "Capture": {
      "type": "object",
      "properties": {
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        },
        "platform": {
          "$ref": "#/$defs/Platform"
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/Measurement"
          }
        },
        "source": {
          "$ref": "#/$defs/Source"
        }
      },
      "required": [
        "capturedAt",
        "platform",
        "results"
      ],
      "additionalProperties": false
    },
    "PlatformList": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlatformChoice"
          }
        }
      },
      "required": [
        "revision",
        "items"
      ],
      "additionalProperties": false
    },
    "BenchmarkPage": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "#/$defs/Digest"
        },
        "platform": {
          "$ref": "#/$defs/Digest"
        },
        "phase": {
          "enum": [
            "compile",
            "instantiate",
            "first-call",
            "steady"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Result"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "revision",
        "platform",
        "phase",
        "items",
        "total",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "PublicationReceipt": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    },
    "Measurement": {
      "type": "object",
      "properties": {
        "workload": {
          "type": "string"
        },
        "wasm": {
          "type": "string"
        },
        "artifactSha256": {
          "$ref": "#/$defs/Digest"
        },
        "contractSha256": {
          "$ref": "#/$defs/Digest"
        },
        "engine": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "compile",
            "instantiate",
            "first-call",
            "steady"
          ]
        },
        "latencyNs": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peakRssBytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "codeBytes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "memoryStatus": {
          "enum": [
            "ok",
            "failed",
            "unsupported",
            "disabled",
            "not-measured"
          ]
        },
        "codeStatus": {
          "enum": [
            "ok",
            "failed",
            "unsupported",
            "disabled",
            "not-measured"
          ]
        },
        "latencyStatus": {
          "enum": [
            "ok",
            "failed",
            "unsupported",
            "disabled",
            "not-measured"
          ]
        },
        "codeKind": {
          "enum": [
            "native-image",
            "engine-reported",
            null
          ]
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "display": {
          "$ref": "#/$defs/Display"
        },
        "timingSamples": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "samplesNs": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "workload",
        "wasm",
        "artifactSha256",
        "contractSha256",
        "engine",
        "version",
        "backend",
        "phase",
        "latencyStatus",
        "latencyNs",
        "memoryStatus",
        "codeStatus",
        "peakRssBytes",
        "codeBytes",
        "codeKind"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "ref",
        "asOf",
        "kind"
      ],
      "properties": {
        "dateBasis": {
          "enum": [
            "go-module-commit",
            "git-tag-commit"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "ref": {
          "type": "string",
          "maxLength": 256
        },
        "asOf": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "enum": [
            "current",
            "main",
            "release",
            "snapshot"
          ]
        }
      }
    },
    "Display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "purpose",
        "tags",
        "abi",
        "bytes",
        "source",
        "reset"
      ],
      "properties": {
        "group": {
          "type": "string",
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "maxLength": 2048
        },
        "tags": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "abi": {
          "type": "string",
          "maxLength": 64
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": "string",
          "maxLength": 2048
        },
        "reset": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}
