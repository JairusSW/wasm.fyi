+// Ordered vector calls use one fresh instance per sequence. Input writes and
+// exact output checks stay outside the sum of timed embedding calls.
+use super::*;
+
+fn number(v: &Value, name: &str, maximum: u64) -> Result<usize> {
+    let value=v[name].as_u64().ok_or_else(||anyhow::anyhow!("invalid vector {name}"))?;
+    ensure!(value<=maximum,"vector {name} exceeds bound");
+    Ok(usize::try_from(value)?)
+}
+fn address(target: &mut embedding::Instance,v: &Value,key: &str,fallback: usize) -> Result<usize> {
+    match v[key].as_str().filter(|s|!s.is_empty()) {
+        None=>Ok(fallback),
+        Some(name)=>{
+            let (params,results)=target.signature(name)?;
+            ensure!(params.is_empty() && results==[0x7f],"unsupported: vector pointer export must be () -> i32");
+            let result=target.call(name,&[])?;Ok(usize::try_from(result[0])?)
+        }
+    }
+}
