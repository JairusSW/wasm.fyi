{
  "root": "../../Tools/wasm-bench",
  "reports": [
    {
      "path": "reports/five-configurations-lifecycle-graph-v18",
      "rebuild": true
    },
    {
      "path": "reports/extra-adapters-v2"
    },
    {
      "path": "reports/five-configurations-composite-v3",
      "rebuild": true
    }
  ],
  "collection": {
    "suite": "wago",
    "runtimes": [
      "wago",
      "wazero",
      "wasmtime",
      "wasmtime-winch",
      "v8",
      "wasmer-llvm",
      "wasmer-singlepass"
    ],
    "featureRuntimes": [
      "wasmer-llvm",
      "wasmer-singlepass"
    ],
    "wagoSource": "../../Wago/wago",
    "launches": 6,
    "samples": 5,
    "operations": 1,
    "warmup": 3,
    "memory": true,
    "code": true,
    "timeout": "30s",
    "phaseBarriers": false
  },
  "retention": 12,
  "hosts": {
    "hub": {
      "ssh": "hub@hub",
      "workspace": ".cache/wasm-fyi"
    }
  },
  "corpus": {
    "source": "wago",
    "ids": [
      "tiny",
      "fib_rec",
      "memory",
      "memory_tree",
      "dispatch",
      "many_funcs",
      "linked_list",
